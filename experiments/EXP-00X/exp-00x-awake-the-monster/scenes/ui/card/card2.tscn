[node name="NarrativeText" type="RichTextLabel" parent="MainLayout/DescriptionRegion" unique_id=478086172]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_colors/default_color = Color(0.105882, 0.0784314, 0.0509804, 1)
theme_override_colors/font_shadow_color = Color(1, 0.941176, 0.827451, 0.3)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
theme_override_fonts/normal_font = ExtResource("4_evpg1")
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "El despertar no fue un transito. Fue una fractura.
La conciencia regresó como un cristal que se astilla y, cuando abrió los ojos, ya estaba allí.

Suspendido sobre una plataforma que parecía recordar haber sido otra cosa, en otro tiempo.
Bajo la plataforma no había suelo. Solo un vacío tan inmenso que la palabra caída perdía todo su significado.

El aire, rancio de eones, sabía a color olvidado.

No era un sueño: eras el intruso en una arquitectura nunca diseñada para ojos humanos."
fit_content = true
scroll_active = false
horizontal_alignment = 1

