[gd_resource type="Resource" script_class="CardData" format=3 uid="uid://c870ltryhv23l"]

[ext_resource type="Script" uid="uid://dyuxcwuhjyju3" path="res://scripts/data/card_data.gd" id="1_card_data"]
[ext_resource type="Texture2D" uid="uid://pctp23kqv7ln" path="res://Assets/illustrations/Cards_Scenes/scene 1.png" id="2_illustration"]
[ext_resource type="Script" uid="uid://dks3aegxwlmg7" path="res://scripts/data/card_option_data.gd" id="3_card_option"]

[sub_resource type="Resource" id="CardOption_awaken"]
script = ExtResource("3_card_option")
text = "Arrojarse al vacío."

[resource]
script = ExtResource("1_card_data")
illustration = ExtResource("2_illustration")
description = "El despertar no fue un tránsito. Fue una fractura.
La conciencia regresó como un cristal astillado —y cuando abrió los ojos, ya estaba allí.
En pie.

Suspendido sobre una plataforma inerte, hecha de un material tan extraño como irreconocible, que parecía recordar haber sido otra cosa, en otro tiempo, bajo otra mano.
Bajo la plataforma no había suelo.
Solo un vacío tan inmenso que la palabra caída perdía todo su significado.

El aire — si es que aquel hálito estancado de eones merecía ese nombre— se respiraba como quien intenta recordar un color olvidado.
No estaba soñando.

Era el intruso de una arquitectura onírica que jamás fue diseñada para ser contemplada por ojos humanos."
options = Array[ExtResource("3_card_option")]([SubResource("CardOption_awaken")])
