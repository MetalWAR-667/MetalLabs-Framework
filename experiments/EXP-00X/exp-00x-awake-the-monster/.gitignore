# Godot: caché, importaciones y configuración local del editor
.godot/
.import/

# Activos fuente pesados / material bruto no necesario para ejecutar el proyecto
raw-textures/
raw-texture/
textures/
Windows-Build/
HTML5-Build/

# IDEs: configuración personal de cada máquina
.vscode/
.idea/

# Exportaciones y builds generados
exports/
builds/
dist/

# Archivos temporales y copias de seguridad
*.tmp
*.temp
*.bak
*.swp
*~
.DS_Store
Thumbs.db

# Logs locales
*.log

# Variables o credenciales locales, si alguna vez las usamos
.env
.env.*

* text=auto

*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.uid text eol=lf
*.import text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.gdshader text eol=lf
*.ts text eol=lf

*.bat text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.svg text eol=lf

backup/
settings.local.json
settings.local.permissive.json
usergodot.lnk